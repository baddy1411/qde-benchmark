# Keep the build context small and the image free of host-specific state.
.git
.venv
venv
**/__pycache__
**/*.pyc
.pytest_cache
.ipynb_checkpoints

# regenerable and large
feature_store
results_registry
mlruns
logs
.snakemake
.dvc/cache

# host artifacts that must never influence a container run
**/.DS_Store
